# Database (Neon Postgres)
DATABASE_URL=

# Admin auth (FWD control plane; FIRSTDOMAIN_* still accepted as fallback)
FWD_ADMIN_PASSWORD=
FWD_SESSION_SECRET=
FIRSTDOMAIN_ADMIN_PASSWORD=
FIRSTDOMAIN_SESSION_SECRET=

# Namecheap API
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true

# Resend Email
RESEND_API_KEY=
FIRSTDOMAIN_FROM_EMAIL=First Domain <hello@yourdomain.com>

# Vercel Blob (media uploads)
BLOB_READ_WRITE_TOKEN=

# Cron authentication
CRON_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
